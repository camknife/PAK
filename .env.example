# 企业微信智能表格 —— 课程读取 + 咨询写入（均走开放 API）
# 获取 corpid：企业微信管理后台 → 我的企业 → 企业信息 → 企业ID
# 获取 corpsecret：应用管理 → 自建 → 创建应用 → 应用详情页 Secret
#   ⚠️ 该自建应用需在「协作-文档-API-可调用接口的应用」开通智能表格权限
#   ⚠️ 服务器公网 IP 需加入「企业可信 IP」白名单，否则 gettoken 会失败
WECOM_CORP_ID=wwxxxxxxxxxxxxx
WECOM_CORP_SECRET=xxxxxxxxxxxxxxxxx

# PAK课程信息表（读取）
WECOM_COURSE_DOCID=your_course_docid
WECOM_COURSE_SHEET_ID=your_course_sheet_id

# PAK用户咨询信息表（写入）
WECOM_FORM_DOCID=your_form_docid
WECOM_FORM_SHEET_ID=your_form_sheet_id
